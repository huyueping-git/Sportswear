<sw:SportWindow x:Class="Sportswear.Views.AlertWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:sw="clr-namespace:Sportswear"
               Width="440"
               SizeToContent="Height"
               WindowStartupLocation="CenterOwner"
               ResizeMode="NoResize"
               ShowInTaskbar="False"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource TextBrush}"
               FontFamily="Microsoft YaHei UI"
               FontSize="14"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="MessageText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   LineHeight="22"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SportGhost}" Width="96" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="确定" Style="{StaticResource SportPrimary}" MinWidth="112" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</sw:SportWindow>
