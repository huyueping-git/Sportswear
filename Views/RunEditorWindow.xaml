<sw:SportWindow x:Class="Sportswear.Views.RunEditorWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:sw="clr-namespace:Sportswear"
               Title="记录里程"
               Width="520"
               MaxHeight="760"
               SizeToContent="Height"
               WindowStartupLocation="CenterOwner"
               ResizeMode="NoResize"
               ShowInTaskbar="False"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource TextBrush}"
               FontFamily="Microsoft YaHei UI"
               FontSize="14"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="保存后会出现在「里程记录」里，并计入这双鞋的磨损。"
                       Margin="0,6,0,18"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"/>

            <TextBlock Text="跑鞋" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ShoeBox" Style="{StaticResource SportCombo}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding PickerLabel}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="日期" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DateBox" Style="{StaticResource SportField}" Height="42" MaxLength="20"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="开始时间" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TimeBox" Style="{StaticResource SportField}" Height="42" MaxLength="8" ToolTip="例如 06:30，可以留空"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="距离 (km)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DistanceBox" Style="{StaticResource SportField}" Height="42" MaxLength="10"/>
                <UniformGrid Columns="4" Margin="0,8,0,0">
                    <Button Content="5 km" Tag="5" Style="{StaticResource SportChoice}" Margin="0,0,8,0" Click="Preset_Click"/>
                    <Button Content="10 km" Tag="10" Style="{StaticResource SportChoice}" Margin="0,0,8,0" Click="Preset_Click"/>
                    <Button Content="半马" Tag="21.0975" Style="{StaticResource SportChoice}" Margin="0,0,8,0" ToolTip="21.0975 km" Click="Preset_Click"/>
                    <Button Content="全马" Tag="42.195" Style="{StaticResource SportChoice}" ToolTip="42.195 km" Click="Preset_Click"/>
                </UniformGrid>
            </StackPanel>
            <TextBlock Text="点常用距离会填进上面的框，也可以自己改。单次最多 500 公里。"
                       Margin="2,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource FaintBrush}"
                       TextWrapping="Wrap"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="天气" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WeatherBox" Style="{StaticResource SportField}" Height="42" MaxLength="20" ToolTip="例如晴、多云、小雨，可以留空"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="气温 (℃)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TemperatureBox" Style="{StaticResource SportField}" Height="42" MaxLength="8" ToolTip="例如 18 或 -2，可以留空"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NotesBox"
                         Style="{StaticResource SportField}"
                         Height="88"
                         VerticalContentAlignment="Top"
                         Padding="12,10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="500"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Margin="2,12,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource SportGhost}" Width="96" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="保存" Style="{StaticResource SportPrimary}" Width="120" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</sw:SportWindow>
