<sw:SportWindow x:Class="Sportswear.MainWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:sw="clr-namespace:Sportswear"
               Title="STRIDE · 跑鞋里程"
               Width="1240"
               Height="800"
               MinWidth="1080"
               MinHeight="680"
               WindowStartupLocation="CenterScreen"
               Background="{StaticResource BgBrush}"
               Foreground="{StaticResource TextBrush}"
               FontFamily="Microsoft YaHei UI"
               FontSize="14"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"
               TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="{StaticResource PanelBrush}">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="36" Height="36" Margin="0,0,12,0"
                           Source="/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STRIDE" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="运动装备  ·  跑鞋里程" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加跑鞋" Style="{StaticResource SportGhost}" Margin="0,0,8,0" Click="AddShoe_Click" ToolTip="Ctrl+N"/>
                    <Button Content="记录里程" Style="{StaticResource SportPrimary}" Click="AddRun_Click" ToolTip="Ctrl+M"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="22,20,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="总览" Foreground="{StaticResource LimeBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="累计里程" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,16,0,0"/>
                        <Viewbox MaxHeight="54" HorizontalAlignment="Left" StretchDirection="DownOnly" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalKmText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="44" FontWeight="SemiBold"/>
                                <TextBlock Text="KM" FontSize="13" Margin="8,24,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Viewbox>

                        <Border Background="{StaticResource LimeDimBrush}" CornerRadius="14" Padding="14,12" Margin="0,16,0,18">
                            <StackPanel>
                                <TextBlock Text="近 7 天" Foreground="{StaticResource LimeBrush}" FontSize="12" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding WeekKmText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="KM" FontSize="12" Margin="6,12,0,0" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WeekHint}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="在役跑鞋" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveCountText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="累计跑步" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding RunCountText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="需要关注" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AttentionCount}"
                                       FontFamily="Bahnschrift, Microsoft YaHei UI"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AttentionCount, Converter={StaticResource PositiveBrush}}"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#161C24" CornerRadius="14" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="更换提醒" Foreground="{StaticResource LimeBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="公路鞋常见寿命大约 600–800 公里。中底发硬或里程到了建议值，就该让这双鞋退役。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20,16,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ShoeViewRadio" Content="跑鞋" GroupName="MainView" Tag="shoes" Style="{StaticResource SportChip}" IsChecked="True" Checked="View_Checked"/>
                        <RadioButton x:Name="RunViewRadio" Content="里程记录" GroupName="MainView" Tag="runs" Style="{StaticResource SportChip}" Checked="View_Checked"/>
                        <TextBlock Text="{Binding ViewCountText}" Foreground="{StaticResource FaintBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding ShowShoeView, Converter={StaticResource BoolVis}}">
                        <RadioButton Content="全部" GroupName="ShoeFilter" Tag="all" Style="{StaticResource SportChip}" IsChecked="True" Checked="Filter_Checked"/>
                        <RadioButton Content="在役" GroupName="ShoeFilter" Tag="active" Style="{StaticResource SportChip}" Checked="Filter_Checked"/>
                        <RadioButton Content="需关注" GroupName="ShoeFilter" Tag="attention" Style="{StaticResource SportChip}" Checked="Filter_Checked"/>
                    </StackPanel>
                    <ComboBox x:Name="RunShoeBox"
                              Grid.Column="2"
                              Width="240"
                              Height="36"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Style="{StaticResource SportCombo}"
                              ItemsSource="{Binding RunShoeOptions}"
                              ToolTip="按跑鞋筛选里程记录"
                              SelectionChanged="RunShoeBox_SelectionChanged"
                              Visibility="{Binding ShowRunShoeFilter, Converter={StaticResource BoolVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PickerLabel}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Border Grid.Row="1"
                        Background="#2A2114"
                        BorderBrush="#6A4A16"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10"
                        Margin="0,0,12,12"
                        Visibility="{Binding ShowAttentionBanner, Converter={StaticResource BoolVis}}">
                    <TextBlock Foreground="#FFD27A" FontSize="13" TextWrapping="Wrap">
                        <Run Text="{Binding AttentionCount, Mode=OneWay}"/>
                        <Run Text=" 双在役跑鞋已到建议寿命的 80% 以上，留意中底和磨损。"/>
                    </TextBlock>
                </Border>

                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding ShowShoeView, Converter={StaticResource BoolVis}}">
                    <ListBox x:Name="ShoeList"
                             ItemsSource="{Binding Shoes}"
                             Style="{StaticResource SportCardList}"
                             ItemContainerStyle="{StaticResource SportShoeItem}"
                             SelectionChanged="ShoeList_SelectionChanged"
                             MouseDoubleClick="ShoeList_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding BrandText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FaintBrush}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White"  Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding MileageText}" Foreground="White" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="26" FontWeight="SemiBold"/>
                                        <TextBlock Text="KM" FontSize="11" Margin="5,12,0,0" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding PercentText}"
                                                   Margin="12,10,0,0"
                                                   FontFamily="Bahnschrift, Microsoft YaHei UI"
                                                   FontSize="14"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                    <Grid Height="8" Margin="0,10,0,0">
                                        <Border Background="#24303A" CornerRadius="4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarValue, Converter={StaticResource BarStar}}"/>
                                                <ColumnDefinition Width="{Binding BarValue, Converter={StaticResource BarRest}}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusBrush}}" CornerRadius="4"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding RemainingText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasShoes, Converter={StaticResource InvBoolVis}}">
                        <Image Width="72" Height="72" HorizontalAlignment="Center"
                               Source="/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="从第一公里开始" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="添加一双跑鞋，记下每次跑步的距离。快到建议寿命时，这里会提醒你更换。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="320"
                                   Margin="0,8,0,0"/>
                        <Button Content="添加跑鞋" Style="{StaticResource SportPrimary}" Width="140" Margin="0,18,0,0" Click="AddShoe_Click" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="这个筛选下没有跑鞋"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding ShowFilterEmpty, Converter={StaticResource BoolVis}}"/>
                    </Grid>

                    <Grid Visibility="{Binding ShowRunView, Converter={StaticResource BoolVis}}" Margin="0,0,12,0">
                        <ListBox x:Name="LogList"
                                 ItemsSource="{Binding AllRuns}"
                                 Style="{StaticResource SportRunList}"
                                 ItemContainerStyle="{StaticResource SportRunItem}"
                                 Visibility="{Binding ShowLogList, Converter={StaticResource BoolVis}}"
                                 SelectionChanged="LogList_SelectionChanged"
                                 MouseDoubleClick="LogList_MouseDoubleClick"
                                 KeyDown="RunList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateText}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding WeekdayText}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding LogTitle}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LogSub}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasLogSub, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DistanceText}" Foreground="White" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="22" FontWeight="SemiBold"/>
                                            <TextBlock Text="KM" FontSize="11" Margin="4,10,0,0" Foreground="{StaticResource MutedBrush}"/>
                                            <Button Content="删除"
                                                    Style="{StaticResource SportDanger}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    Margin="12,0,0,0"
                                                    FontSize="12"
                                                    Focusable="False"
                                                    ToolTip="只删除这条里程，跑鞋会保留"
                                                    Click="DeleteListedRun_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasAnyRuns, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Text="还没有里程记录" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="记下一趟跑步后，日期、距离、天气和开跑时间都会出现在这里。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Margin="0,8,0,0"/>
                            <Button Content="记录里程" Style="{StaticResource SportPrimary}" Width="140" Margin="0,18,0,0" Click="AddRun_Click" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding ShowLogFilterEmpty, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="这双鞋还没有里程" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="换一双鞋，或记下一趟跑步。记录会按上面选择的跑鞋筛选。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Margin="0,8,0,0"/>
                            <Button Content="记录里程" Style="{StaticResource SportPrimary}" Width="140" Margin="0,18,0,0" Click="AddRun_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}" Margin="20,18,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.BrandText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource LimeBrush}"/>
                            <TextBlock Text="{Binding Selected.Name}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Selected.MetaText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Selected.PurchaseText}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="{Binding Selected.MileageText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="40" FontWeight="SemiBold"/>
                                <TextBlock Text="KM" Margin="8,20,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.RetireText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Selected.BreakdownText}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,2,0,0"/>

                            <Grid Height="8" Margin="0,14,0,0">
                                <Border Background="#24303A" CornerRadius="4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Selected.BarValue, Converter={StaticResource BarStar}}"/>
                                        <ColumnDefinition Width="{Binding Selected.BarValue, Converter={StaticResource BarRest}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Selected.Status, Converter={StaticResource StatusBrush}}" CornerRadius="4"/>
                                </Grid>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Selected.PercentText}"
                                           FontFamily="Bahnschrift, Microsoft YaHei UI"
                                           Foreground="{Binding Selected.Status, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding Selected.RemainingText, StringFormat=  ·  {0}}" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.StatusText}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{Binding Selected.Status, Converter={StaticResource StatusBrush}}"/>

                            <TextBlock Text="{Binding Selected.Notes}"
                                       TextWrapping="Wrap"
                                       MaxHeight="60"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       ToolTip="{Binding Selected.Notes}"
                                       Visibility="{Binding Selected.HasNotes, Converter={StaticResource BoolVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>

                            <WrapPanel Margin="0,16,0,8">
                                <Button Content="记录里程" Style="{StaticResource SportPrimary}" Margin="0,0,8,8" Click="AddRun_Click"/>
                                <Button Content="编辑资料" Style="{StaticResource SportGhost}" Margin="0,0,8,8" Click="EditShoe_Click"/>
                                <Button Content="{Binding Selected.RetireButtonText}" Style="{StaticResource SportGhost}" Margin="0,0,8,8" Click="ToggleRetired_Click"/>
                                <Button Content="删除跑鞋" Style="{StaticResource SportDanger}" Margin="0,0,8,8" Click="DeleteShoe_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding RunHeaderText}" FontWeight="Bold" Margin="0,4,0,10"/>
                            <ListBox x:Name="RunList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Runs}"
                                     SelectedItem="{Binding SelectedRun}"
                                     Style="{StaticResource SportRunList}"
                                     ItemContainerStyle="{StaticResource SportRunItem}"
                                     Visibility="{Binding HasRuns, Converter={StaticResource BoolVis}}"
                                     MouseDoubleClick="RunList_MouseDoubleClick"
                                     KeyDown="RunList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding WeekdayText}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ShoeRunMeta}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="4,0,8,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DistanceText}" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="KM" FontSize="11" Margin="4,8,0,0" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1"
                                       Text="还没有里程。记下一趟跑步，累计就会从这里开始。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ShowRunEmpty, Converter={StaticResource BoolVis}}"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasRuns, Converter={StaticResource BoolVis}}">
                                <Button Content="修改记录" Style="{StaticResource SportGhost}" Margin="0,0,8,0" Click="EditRun_Click" IsEnabled="{Binding HasSelectedRun}"/>
                                <Button Content="删除记录" Style="{StaticResource SportDanger}" Click="DeleteRun_Click" IsEnabled="{Binding HasSelectedRun}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28"
                                Visibility="{Binding HasSelection, Converter={StaticResource InvBoolVis}}">
                        <TextBlock Text="选择一双跑鞋" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="点中间的卡片，查看磨损进度。&#x0a;记录里程和编辑资料也在这里。"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Button DockPanel.Dock="Right" Content="打开数据目录" Style="{StaticResource SportLink}" Click="OpenDataFolder_Click"/>
                <TextBlock Text="{Binding FooterText}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FaintBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</sw:SportWindow>
